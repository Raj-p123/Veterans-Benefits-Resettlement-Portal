# ==============================================================================
# VETERANS BENEFITS & RESETTLEMENT PORTAL — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# MongoDB Database Connection String
# For Local Development: mongodb://127.0.0.1:27017/veterans_portal
# For Production (MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/veterans_portal?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret & Session Duration (Minimum 32 random characters recommended for production)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Allowed Frontend URLs for Production CORS and Socket.IO
# (Set to your deployed frontend domain, e.g., https://veterans-portal.vercel.app)
FRONTEND_URL=
CLIENT_URL=

# Default Administrator Seed Credentials
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Transactional Email Service (Resend API)
# Get your API key from https://resend.com
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Cloud Media & Document Storage (Cloudinary - Optional for persistent storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External Official Schemes Search (Tavily CSE - Optional)
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search
SEARCH_PROVIDER=tavily
