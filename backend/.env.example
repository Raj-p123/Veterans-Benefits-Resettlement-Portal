PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/veterans_portal
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Default Admin Seed Credentials
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!

# Cloudinary Storage (Optional, falls back to local uploads/documents/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Transactional Email API Configuration
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# External Official Search API Configuration (Optional, e.g. Tavily / Google CSE / Brave Search)
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search
SEARCH_PROVIDER=tavily
