# ==============================================================================
# VETERANS BENEFITS & RESETTLEMENT PORTAL — FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend REST API URL:
# - When deployed together on Render as ONE service: leave empty or use /api
# - For separate backend deployment: https://your-backend-api.onrender.com/api
# - For local development: http://localhost:5000/api (automatic if port is 5173/3000)
VITE_API_URL=/api

# Backend Real-Time Socket.IO Server URL:
# - When deployed together on Render as ONE service: leave empty (automatically connects to window.location.origin)
# - For separate backend deployment: https://your-backend-api.onrender.com
# - For local development: http://localhost:5000 (automatic if port is 5173/3000)
VITE_SOCKET_URL=
