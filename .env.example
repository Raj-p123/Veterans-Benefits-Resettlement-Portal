# ==============================================================================
# VETERANS BENEFITS & RESETTLEMENT PORTAL — ROOT ENVIRONMENT OVERVIEW
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND VARIABLES (Set in backend host, e.g. Render / Railway / Server)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/veterans_portal?retryWrites=true&w=majority
JWT_SECRET=your_production_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=1d
FRONTEND_URL=https://your-frontend-domain.vercel.app
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Storage (Optional persistent cloud storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 2. FRONTEND VARIABLES (Set in frontend host, e.g. Vercel / Netlify)
# ------------------------------------------------------------------------------
VITE_API_URL=https://your-backend-domain.onrender.com/api
VITE_SOCKET_URL=https://your-backend-domain.onrender.com
