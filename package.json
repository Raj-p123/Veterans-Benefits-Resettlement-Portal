{
  "name": "veterans-benefits-and-resettlement-portal",
  "version": "1.0.0",
  "description": "Centralized platform for veterans to access pensions, welfare schemes, employment, and resettlement programs.",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run --prefix backend dev",
    "dev:frontend": "npm run --prefix frontend dev",
    "start": "npm run --prefix backend start",
    "seed": "npm run --prefix backend seed",
    "build": "npm run --prefix frontend build",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "veterans",
    "resettlement",
    "welfare-schemes",
    "jobs",
    "defense",
    "portal"
  ],
  "author": "",
  "license": "ISC"
}
